<Window x:Class="MagicMusicWall.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:MagicMusicWall.Core;assembly=MagicMusicWall.Core" xmlns:local="clr-namespace:MagicMusicWall.App" Title="Magic Music Wall" Width="1420" Height="900" MinWidth="1120" MinHeight="720" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" Closing="Window_Closing">
 <Grid x:Name="WorkspaceRoot">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="136"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="QueueColumn" Width="310"/></Grid.ColumnDefinitions>
  <Border x:Name="LibrarySidebar" Background="#151820" BorderBrush="#292D38" BorderThickness="0,0,1,0">
   <DockPanel Margin="14,14,14,12">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="▥  MAGIC" FontSize="25" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
     <TextBlock Text="M U S I C   W A L L" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="4,4,0,14"/>
     <TextBlock Text="YOUR LIBRARY" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,0,0,8"/>
     <ListBox x:Name="ViewsList" SelectionChanged="ViewsList_SelectionChanged"><ListBoxItem Content="♫   All music" Tag="music" IsSelected="True"/><ListBoxItem Content="▣   Videos" Tag="video"/><ListBoxItem Content="☷   All media" Tag="all"/></ListBox>
     <Grid Margin="10,14,0,8"><TextBlock Text="PLAYLISTS" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button Content="+" HorizontalAlignment="Right" Padding="9,2" Click="CreatePlaylist_Click" ToolTip="Create a playlist from selected songs, the queue, or an empty list" AutomationProperties.Name="Create playlist"/></Grid>
     <TextBlock Text="Click to browse · double-click to play" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,6" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Expander x:Name="LibraryTools" Header="Library tools" ToolTip="Collapse these buttons to make more room for playlists" IsExpanded="True" Foreground="{StaticResource TextBrush}" Expanded="ToolsExpansion_Changed" Collapsed="ToolsExpansion_Changed"><StackPanel>
     <Button Content="Manage folders" Click="ManageFolders_Click" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
     <Button x:Name="RescanButton" Content="Rescan library" Click="Rescan_Click" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
     <Button Content="Music constellation" Click="MusicMap_Click" HorizontalAlignment="Stretch" Margin="0,4,0,0" AutomationProperties.Name="Music constellation"/>
     <Button Content="AI playlist assistant" Click="AiPlaylist_Click" Margin="0,4,0,0"/>
     <Button Content="⚙  Setup" Click="Setup_Click" HorizontalAlignment="Stretch" Margin="0,4,0,0" AutomationProperties.Name="Setup"/>
     </StackPanel></Expander>
     <Button Click="Brand_Click" Background="Transparent" Padding="5,4" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Visit DigitalRCS.com" AutomationProperties.Name="DigitalRCS.com website"><StackPanel Orientation="Horizontal"><Image Source="Assets/digitalrcs-logo.png" Width="28" Height="28"/><TextBlock Text="DigitalRCS.com" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button>
    </StackPanel>
    <ListBox x:Name="PlaylistsList" IsSynchronizedWithCurrentItem="False" SelectionChanged="PlaylistsList_SelectionChanged" MouseDoubleClick="PlaylistsList_DoubleClick" AutomationProperties.Name="Saved playlists"><ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Smart"/><Style.Triggers><DataTrigger Binding="{Binding Rule}" Value="{x:Null}"><Setter Property="Text" Value="{Binding ItemIds.Count}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate><ListBox.ContextMenu><ContextMenu><MenuItem Header="Rename playlist" Click="RenamePlaylist_Click"/><MenuItem Header="Delete playlist" Click="DeletePlaylist_Click"/><Separator/><MenuItem Header="Import M3U playlist…" Click="ImportPlaylistFile_Click"/><MenuItem Header="Export playlist…" Click="ExportPlaylistFile_Click"/></ContextMenu></ListBox.ContextMenu></ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" x:Name="CollectionWorkspace" Margin="16,18,16,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Search artist, album, title, genre or folder" AutomationProperties.Name="Search library" FontSize="15" MinHeight="44"/><TextBlock Text="Search artists, albums, songs…" IsHitTestVisible="False" Margin="14,12" Foreground="#8991A7" x:Name="SearchHint"/><Button Grid.Column="1" Content="Clear" Click="ClearSearch_Click" Margin="8,0,0,0"/></Grid>
   <StackPanel Grid.Row="1" Margin="0,16,0,12"><TextBlock Text="LISTEN LOCAL" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="ViewTitle" Text="Your collection" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,3"/><TextBlock x:Name="LibrarySummary" Text="Bring your music together, wherever it lives." Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel>
   <WrapPanel Grid.Row="2" Margin="0,0,0,8"><Button x:Name="PlayResultsButton" Content="▶  Play results" Style="{StaticResource AccentButton}" Click="PlayResults_Click" Margin="0,0,8,8"/><Button x:Name="QueuePlaylistButton" Content="+ Queue playlist" Click="QueuePlaylist_Click" Visibility="Collapsed" Margin="0,0,8,8" ToolTip="Append this playlist's displayed songs without interrupting playback"/><Button Content="Queue selected" Click="QueueSelected_Click" Margin="0,0,8,8"/><Button Content="Play next" Click="PlayNext_Click" Margin="0,0,8,8"/><Button Content="Song info / lyrics" Click="Info_Click" Margin="0,0,8,8"/><Button Content="Add to playlist…" Click="AddToPlaylist_Click" Margin="0,0,8,8"/><Button Content="View options" Click="ViewOptions_Click" Margin="0,0,0,8"/></WrapPanel>
   <Grid Grid.Row="3">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
     <RadioButton x:Name="LibraryMode" Content="Music list" GroupName="CenterMode" IsChecked="True" Checked="CenterMode_Changed" Foreground="{StaticResource TextBrush}" Margin="0,0,24,0"/>
     <Button Content="Mini player" Click="MiniPlayer_Click" Padding="8,3" Margin="0,0,12,0"/><RadioButton x:Name="VisualMode" Content="Playing music · visuals" GroupName="CenterMode" Checked="CenterMode_Changed" Foreground="{StaticResource TextBrush}"/>
    </StackPanel>
    <Grid Grid.Row="1" x:Name="VisualizerPanel" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Reconnect visuals" Click="ReconnectVisuals_Click" Margin="8,0,0,0"/><ComboBox x:Name="VisualStyle" SelectionChanged="VisualStyle_Changed" AutomationProperties.Name="Visualization style"/></DockPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
      <Border BorderBrush="#858DA3" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><local:PlaybackVisualizer x:Name="MusicVisual"/></Border>
      <Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="#858DA3" BorderThickness="1" CornerRadius="8" Padding="6,10" Background="#191C25">
       <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Visual&#10;power" TextAlignment="Center" FontSize="12"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
         <TextBlock x:Name="VisualPowerText" Text="1.60×" TextAlignment="Center"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button Content="−" Click="VisualPowerDown_Click" Width="30" Padding="0,5" Margin="0,0,4,0" ToolTip="Decrease visual power by 0.01" AutomationProperties.Name="Decrease visual power"/>
          <Button Content="+" Click="VisualPowerUp_Click" Width="30" Padding="0,5" ToolTip="Increase visual power by 0.01" AutomationProperties.Name="Increase visual power"/>
         </StackPanel>
        </StackPanel>
        <Slider x:Name="VisualPowerSlider" Orientation="Vertical" Minimum="0.5" Maximum="3" Value="1.6" SmallChange="0.01" LargeChange="0.05" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="VisualPower_Changed" Margin="0,10,0,0" Width="22" VerticalAlignment="Stretch" HorizontalAlignment="Center" IsMoveToPointEnabled="False" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2" ToolTip="Drag for visual power; arrow keys or + / − adjust by 0.01. Audio volume is unchanged." AutomationProperties.Name="Visual power">
         <Slider.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="1.5"/></Slider.LayoutTransform>
        </Slider>
       </DockPanel>
      </Border>
     </Grid>
     <TextBlock Grid.Row="2" x:Name="VisualStatus" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
    </Grid>
    <Grid Grid.Row="1" x:Name="CollectionPanel">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel x:Name="FolderNavigation" Margin="0,0,0,8" Visibility="Collapsed">
     <DockPanel LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="All folders" Click="FolderHome_Click" Padding="10,6" Margin="0,0,6,0"/><Button x:Name="FolderUpButton" Content="↑ Up" Click="FolderUp_Click" Padding="10,6" Margin="0,0,8,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"><Button x:Name="FoldersViewButton" Content="Folders" Click="FoldersView_Click" Padding="12,6" Margin="0,0,5,0" ToolTip="Browse your indexed library folders" AutomationProperties.Name="Browse folders"/><Button x:Name="GridViewButton" Content="All songs" Click="GridView_Click" Padding="12,6" ToolTip="List all songs in your library" AutomationProperties.Name="Show all songs"/></StackPanel>
     </DockPanel>
     <DockPanel Margin="0,8,0,0">
      <TextBlock x:Name="FolderBreadcrumb" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     </DockPanel>
    </StackPanel>
    <ListView Grid.Row="1" x:Name="MediaGrid" MouseDoubleClick="Library_DoubleClick" SelectionMode="Extended" KeyDown="MediaGrid_KeyDown" PreviewMouseRightButtonDown="MediaGrid_PreviewMouseRightButtonDown" ContextMenuOpening="MediaGrid_ContextMenuOpening" Loaded="Directory_Loaded" SizeChanged="Directory_SizeChanged" AutomationProperties.Name="Indexed library folders and files" Background="#171A22" Foreground="{StaticResource TextBrush}" BorderThickness="0" FontSize="12" AlternationCount="2" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
     <ListView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="18" Margin="8,16,8,8" Foreground="{StaticResource AccentBrush}"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle><ListView.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
     <ListView.Resources>
      <Style x:Key="DirectoryNameButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
       <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="3,4"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NameChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NameChrome" Property="Background" Value="#302A3E"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NameChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="NameChrome" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="DirectoryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="6,3"/><Setter Property="Height" Value="28"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Background" Value="#262A36"/></Style>
      <Style x:Key="DirectoryHeader" TargetType="GridViewColumnHeader">
       <Setter Property="Background" Value="#20242E"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="7,4"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><Thumb x:Name="PART_HeaderGripper" Width="5" HorizontalAlignment="Right" Cursor="SizeWE"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template></Thumb></Grid><ControlTemplate.Triggers><Trigger Property="Role" Value="Padding"><Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
      <DataTemplate x:Key="DirectoryEmptyCell"><TextBlock/></DataTemplate>
      <DataTemplate x:Key="DirectorySelectFile"><CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Select for playlist or batch actions" AutomationProperties.Name="{Binding FileName, StringFormat=Select {0}}"/></DataTemplate>
      <DataTemplate x:Key="DirectoryFolderName"><DockPanel Margin="7,0" ToolTip="{Binding Path}"><TextBlock Text="▣" Foreground="#D7B76E" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate>
      <DataTemplate x:Key="DirectoryFileName"><DockPanel Margin="7,0" ToolTip="{Binding Path}"><TextBlock Text="♫" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></DataTemplate>
      <DataTemplate x:Key="DirectoryFileArtist"><TextBlock Text="{Binding Artist}" ToolTip="{Binding Artist}" TextTrimming="CharacterEllipsis" Margin="7,0" VerticalAlignment="Center"/></DataTemplate>
      <DataTemplate x:Key="DirectoryFileAlbum"><TextBlock Text="{Binding Album}" ToolTip="{Binding Album}" TextTrimming="CharacterEllipsis" Margin="7,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></DataTemplate>
      <DataTemplate x:Key="DirectoryFileTime"><TextBlock Text="{Binding DurationText}" Margin="7,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></DataTemplate>
      <DataTemplate x:Key="DirectoryFolderCount"><TextBlock Text="{Binding Detail}" Margin="7,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Foreground="{StaticResource MutedBrush}"/></DataTemplate>
      <DataTemplate x:Key="DirectoryFolderActions"><Button Content="+ Queue folder" Click="QueueFolder_Click" Tag="{Binding}" Style="{StaticResource DirectoryActionButton}" HorizontalAlignment="Left" ToolTip="Add indexed media from this folder and its subfolders to the queue" AutomationProperties.Name="{Binding Name, StringFormat=Queue folder {0}}"/></DataTemplate>
      <DataTemplate x:Key="DirectoryFileActions"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="+ Queue" Click="QueueItem_Click" Tag="{Binding}" Style="{StaticResource DirectoryActionButton}" ToolTip="Add only this file to the queue" AutomationProperties.Name="{Binding FileName, StringFormat=Queue {0}}"/><Button Content="Play" Click="PlayItem_Click" Tag="{Binding}" Style="{StaticResource DirectoryActionButton}" ToolTip="Play only this file now" AutomationProperties.Name="{Binding FileName, StringFormat=Play {0}}"/><Button Content="Info" Click="ItemInfo_Click" Tag="{Binding}" Style="{StaticResource DirectoryActionButton}" ToolTip="Song info, lyrics and facts" AutomationProperties.Name="{Binding FileName, StringFormat=Info for {0}}"/></StackPanel></DataTemplate>
      <local:DirectoryTemplateSelector x:Key="DirectorySelectSelector" FolderTemplate="{StaticResource DirectoryEmptyCell}" FileTemplate="{StaticResource DirectorySelectFile}"/>
      <local:DirectoryTemplateSelector x:Key="DirectoryNameSelector" FolderTemplate="{StaticResource DirectoryFolderName}" FileTemplate="{StaticResource DirectoryFileName}"/>
      <local:DirectoryTemplateSelector x:Key="DirectoryArtistSelector" FolderTemplate="{StaticResource DirectoryEmptyCell}" FileTemplate="{StaticResource DirectoryFileArtist}"/>
      <local:DirectoryTemplateSelector x:Key="DirectoryAlbumSelector" FolderTemplate="{StaticResource DirectoryEmptyCell}" FileTemplate="{StaticResource DirectoryFileAlbum}"/>
      <local:DirectoryTemplateSelector x:Key="DirectoryTimeSelector" FolderTemplate="{StaticResource DirectoryFolderCount}" FileTemplate="{StaticResource DirectoryFileTime}"/>
      <local:DirectoryTemplateSelector x:Key="DirectoryActionsSelector" FolderTemplate="{StaticResource DirectoryFolderActions}" FileTemplate="{StaticResource DirectoryFileActions}"/>
     </ListView.Resources>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="#171A22"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="DirectoryRow" Background="{TemplateBinding Background}" BorderBrush="#292D38" BorderThickness="0,0,0,1"><GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter TargetName="DirectoryRow" Property="Background" Value="#1B1F29"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DirectoryRow" Property="Background" Value="#272B38"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="DirectoryRow" Property="Background" Value="#39304D"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DirectoryRow" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
     <ListView.View><GridView AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource DirectoryHeader}"><GridViewColumn Header="" Width="30" CellTemplateSelector="{StaticResource DirectorySelectSelector}"/><GridViewColumn x:Name="DirectoryNameColumn" Header="Name" Width="290" CellTemplateSelector="{StaticResource DirectoryNameSelector}"/><GridViewColumn Header="Artist" Width="125" CellTemplateSelector="{StaticResource DirectoryArtistSelector}"/><GridViewColumn Header="Album" Width="145" CellTemplateSelector="{StaticResource DirectoryAlbumSelector}"/><GridViewColumn Header="Time / items" Width="88" CellTemplateSelector="{StaticResource DirectoryTimeSelector}"/><GridViewColumn Header="Actions" Width="168" CellTemplateSelector="{StaticResource DirectoryActionsSelector}"/></GridView></ListView.View>
     <ListView.ContextMenu><ContextMenu><MenuItem Header="Play selected" Click="PlaySelected_Click"/><MenuItem Header="Add to queue" Click="QueueSelected_Click"/><Separator/><MenuItem Header="Song info / lyrics" Click="Info_Click"/><MenuItem Header="Edit file tags…" Click="Metadata_Click"/><MenuItem Header="Show in Explorer" Click="ShowFile_Click"/><MenuItem Header="Share selected file on LAN…" Click="Share_Click"/><Separator/><MenuItem Header="Move up in playlist" Click="PlaylistUp_Click"/><MenuItem Header="Move down in playlist" Click="PlaylistDown_Click"/><MenuItem Header="Remove from this playlist" Click="RemoveFromPlaylist_Click"/><MenuItem Header="Remove from library (keep file)" Click="RemoveFromLibrary_Click"/></ContextMenu></ListView.ContextMenu>
    </ListView>
    <Border Grid.Row="1" x:Name="EmptyPanel" Background="#171A22" CornerRadius="10" Padding="40"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="♫" FontSize="62" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="Make room for your music" FontSize="23" TextAlignment="Center" Margin="0,16,0,10"/><TextBlock x:Name="EmptyDescription" Text="Use Manage folders to add folders or individual files.&#10;Your original files stay right where they are." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="24"/><Button x:Name="EmptyLibraryButton" Content="Manage folders" Click="EmptyLibrary_Click" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,24,0,0"/></StackPanel></Border>
   </Grid>
   </Grid>
   <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Text="Ready. Add folders or drop files here."/><Button Grid.Column="1" x:Name="CancelImportButton" Content="Cancel scan" Visibility="Collapsed" Padding="8,2" Click="CancelScan_Click"/></Grid>
  </Grid>
  <GridSplitter Grid.Column="0" HorizontalAlignment="Right" Width="5" Background="#343848" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragCompleted="PanelResize_Completed"/>
  <GridSplitter Grid.Column="2" HorizontalAlignment="Left" Width="5" Background="#343848" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent" DragCompleted="PanelResize_Completed"/>
  <Border x:Name="QueueSidebar" Grid.Column="2" Margin="5,0,0,0" Background="#151820" BorderBrush="#292D38" BorderThickness="1,0,0,0">
   <Grid Margin="14,18,14,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Expander Foreground="{StaticResource TextBrush}" Header="TV &amp; video output" Margin="0,0,0,10"><StackPanel Margin="0,8,0,0"><ComboBox x:Name="CastDevicesBox" DisplayMemberPath="Name" SelectionChanged="CastDevice_Changed" AutomationProperties.Name="Video renderer"/><Button Content="Find / refresh Chromecasts" Click="FindCast_Click" Margin="0,8,0,6"/><Button Content="Share file to Fire TV / VLC…" Click="Share_Click"/></StackPanel></Expander>
    <ComboBox x:Name="PlaylistDestinationBox" Visibility="Collapsed" DisplayMemberPath="Name"/><DockPanel Grid.Row="1" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Find next" Click="QueueSearchNext_Click" Padding="6,4"/><TextBox x:Name="QueueSearchBox" KeyDown="QueueSearch_KeyDown" ToolTip="Search queue · Enter finds next match" AutomationProperties.Name="Search queue"/></DockPanel>
    <Grid Grid.Row="2" Margin="0,0,0,8"><TextBlock x:Name="QueueTitle" Text="UP NEXT · 0" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Save queue" Click="SaveQueue_Click" Padding="8,3" Margin="0,0,5,0" ToolTip="Save queue as a playlist"/><Button Content="Clear queue" Click="ClearQueue_Click" Padding="8,3"/></StackPanel></Grid>
    <StackPanel Grid.Row="4"><TextBlock x:Name="QueueRemainingText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,4"/><WrapPanel><Button Content="↑" Click="QueueUp_Click" ToolTip="Move selected up" AutomationProperties.Name="Move queue item up" Padding="9,5" Margin="0,0,4,0"/><Button Content="↓" Click="QueueDown_Click" ToolTip="Move selected down" AutomationProperties.Name="Move queue item down" Padding="9,5" Margin="0,0,4,0"/><Button Content="Remove" Click="QueueRemove_Click" Padding="8,5" Margin="0,0,4,0"/><Button Content="Undo" Click="UndoQueue_Click" Padding="8,5"/></WrapPanel></StackPanel>
    <ListBox Grid.Row="3" x:Name="QueueList" SelectionMode="Extended" MouseDoubleClick="Queue_DoubleClick" PreviewMouseRightButtonDown="QueueList_PreviewMouseRightButtonDown" ContextMenuOpening="QueueList_ContextMenuOpening" AutomationProperties.Name="Playback queue"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"/><TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate><ListBox.ContextMenu><ContextMenu><MenuItem x:Name="QueueInfoMenuItem" Header="Song info / lyrics" Click="QueueInfo_Click"/><MenuItem x:Name="QueueMetadataMenuItem" Header="Edit file tags…" Click="QueueMetadata_Click"/><Separator x:Name="QueueInfoSeparator"/><MenuItem Header="Move up" Click="QueueUp_Click"/><MenuItem Header="Move down" Click="QueueDown_Click"/><MenuItem Header="Remove from queue" Click="QueueRemove_Click"/><Separator/><MenuItem Header="Undo last queue change" Click="UndoQueue_Click"/><MenuItem Header="Remove duplicate queue entries" Click="QueueDeduplicate_Click"/><MenuItem Header="Save queue as playlist…" Click="SaveQueue_Click"/></ContextMenu></ListBox.ContextMenu></ListBox>
   </Grid>
  </Border>
  <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#20232D" BorderBrush="#343848" BorderThickness="0,1,0,0">
   <Grid Margin="24,16"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#3B3151" CornerRadius="6" Width="58" Height="58" HorizontalAlignment="Left"><Grid><TextBlock Text="♫" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image x:Name="NowArtwork" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="NowTitle" Text="Nothing playing yet" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowArtist" Text="Choose something you love" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
    <Grid Grid.Column="1" Margin="18,0"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><CheckBox x:Name="ShuffleBox" Content="Shuffle" Margin="0,0,16,0"/><Button Content="⏮" Click="Previous_Click" Padding="12,6" ToolTip="Previous"/><Button x:Name="PauseButton" Content="▶" Click="Pause_Click" Style="{StaticResource AccentButton}" Padding="22,6" Margin="8,0" ToolTip="Play / pause" AutomationProperties.Name="Play pause"/><Button Content="⏭" Click="Next_Click" Padding="12,6" ToolTip="Next"/><CheckBox x:Name="RepeatBox" Content="Repeat queue" Margin="16,0,0,0"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedText" Text="0:00" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="24"/></Grid.RowDefinitions><local:PlaybackSeekSlider x:Name="SeekSlider" Minimum="0" Maximum="1" SmallChange="5000" LargeChange="15000" SeekStarted="Seek_Begin" SeekCommitted="Seek_End" SeekCancelled="Seek_Cancel" ValueChanged="Seek_Changed" VerticalAlignment="Stretch" IsEnabled="False" ToolTip="Click or drag to seek; Escape cancels a drag" AutomationProperties.Name="Playback position"/><Canvas x:Name="SeekMarks" Grid.Row="1" Margin="6,0" Height="24" IsHitTestVisible="False" SizeChanged="SeekMarks_SizeChanged"/></Grid><TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" TextAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid></Grid>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><ComboBox x:Name="AudioDevicesBox" DisplayMemberPath="Name" SelectionChanged="AudioDevice_Changed" AutomationProperties.Name="Audio output device" ToolTip="{Binding ElementName=AudioRouteText, Path=Text}" Margin="0,0,0,5"/><TextBlock x:Name="AudioRouteText" Visibility="Collapsed"/><DockPanel><TextBlock Text="VOLUME" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="VolumeText" Text="65%" HorizontalAlignment="Right" FontSize="11"/></DockPanel><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="65" ValueChanged="Volume_Changed" AutomationProperties.Name="Volume"/><WrapPanel HorizontalAlignment="Right" Margin="0,4,0,0"><Button Content="Song info" Click="NowInfo_Click" Padding="8,4" Margin="0,0,6,0"/><Button Content="Show video" Click="ShowVideo_Click" Padding="8,4"/></WrapPanel></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
